BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:8787
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/acme_erp?sslmode=disable
ADMIN_EMAIL=admin@acmehospital.local
ADMIN_PASSWORD=Admin@12345

# Web Push keys are generated on first container start and kept in the
# persistent `vapid_keys` Docker volume. Set both values to supply your own pair.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@acmehospital.health

# MinIO / S3 Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=miniopassword
MINIO_BUCKET=acme-erp

# Docterz Clinic API Integration (Optional)
DOCTERZ_AUTHORIZATION=
DOCTERZ_API_KEY=
DOCTERZ_APP_KEY=
DOCTERZ_CLINIC_ID=
DOCTERZ_DOCTOR_IDS=
DOCTERZ_BASE_URL=https://api.docterz.in/admin/reports/clinic/consultation_report
DOCTERZ_REFERER=https://web.docterz.in/
