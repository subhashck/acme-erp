{
  "name": "acme-erp-hospital",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview --host 0.0.0.0",
    "db:push": "drizzle-kit push",
    "db:setup": "tsx server/db/setup-inventory-db.ts && tsx server/db/setup-magazine-db.ts",
    "db:seed": "tsx server/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc -b",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:db:snapshot": "docker exec acme-erp-db pg_dump -U postgres -d acme_erp --clean --if-exists --no-owner --no-privileges > tests/fixtures/dev-db-snapshot.sql"
  },
  "dependencies": {
