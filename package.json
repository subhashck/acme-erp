{
  "name": "acme-erp-hospital",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:full": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "preview": "vite preview --host 0.0.0.0",
    "db:setup-push": "tsx server/db/setup-push-db.ts",
    "db:push": "drizzle-kit push",
    "db:setup": "tsx server/db/setup-inventory-db.ts && tsx server/db/setup-front-office-db.ts && tsx server/db/setup-capital-db.ts && tsx server/db/setup-skill-assessment-db.ts && tsx server/db/migrate-security-deposit-opening.ts && tsx server/db/setup-push-db.ts",
    "db:seed": "tsx server/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "front-office:backfill-last-visited": "tsx scripts/backfill-patient-last-visited.ts",
    "payroll:recalculate-leaves": "tsx scripts/recalculate_payslip_leave_deductions.ts",
    "assessments:delete": "tsx scripts/delete_all_assessments.ts",
    "assessments:seed-questions": "tsx scripts/seed_500_questions.ts",
    "assessments:seed-departments": "tsx scripts/seed_500_questions.ts",
    "assessments:migrate-question-mix": "tsx server/db/migrate-exam-question-mix.ts",
    "db:migrate-nursing-applicant-batch": "tsx server/db/migrate-nursing-applicant-batch.ts",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:db:snapshot": "docker exec acme-erp-db pg_dump -U postgres -d acme_erp --clean --if-exists --no-owner --no-privileges > tests/fixtures/dev-db-snapshot.sql",
    "magazine:purge": "tsx scripts/purge-erp-magazine.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@hono/node-server": "^2.0.4",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-store": "^0.11.0",
    "better-auth": "^1.6.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "html2canvas-pro": "^1.5.8",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.17.0",
    "mime-types": "^3.0.2",
    "minio": "^8.0.7",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-currency-format": "^1.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.68.0",
    "recharts": "^3.5.0",
    "shadcn": "^4.11.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/router-plugin": "1.168.18",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.10.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-currency-format": "^1.0.4",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "jsqr": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1"
  }
}
